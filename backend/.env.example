# Copy this file to `.env` and adjust for your setup.
# In production (Render, Railway, etc.) set these as real environment
# variables in the platform's dashboard instead of committing a .env file.

# Origin(s) allowed to talk to this server, comma-separated if more than
# one. Only matters for cross-origin setups:
#   - local split-dev: Vite dev server on :5173 calling the API on :3000
#   - a frontend hosted separately from this backend (e.g. two Render
#     services, or a frontend on Vercel talking to a backend elsewhere)
# When this backend serves the built frontend itself (the normal
# single-service production setup — see server.js's static-file block),
# requests are same-origin and this is never consulted by the browser.
FRONTEND_URL=http://localhost:5173

# Port the server listens on. Render/Railway/etc. set this automatically —
# leave it out of your platform env vars and only use this for local dev.
PORT=3000
