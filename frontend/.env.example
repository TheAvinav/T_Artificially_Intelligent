# Copy this file to `.env` and adjust for your setup.

# Only needed for local split-dev, where the Vite dev server (:5173) and
# the backend (:3000) run as two separate processes. Point this at the
# backend's URL so the browser knows where to open its Socket.IO
# connection.
#
# In production, leave this unset (don't define it at all in your hosting
# platform's env vars) — the backend serves this built frontend itself, so
# the client should connect to the same origin the page loaded from.
VITE_SERVER_URL=http://localhost:3000
